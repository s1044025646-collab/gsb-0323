{
  "name": "vc-causal-backend",
  "version": "1.0.0",
  "description": "离线分布式事件向量时钟因果关系与一致切片核验后端（仅 API 与 CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "start": "node --experimental-sqlite dist/src/server.js",
    "cli": "node --experimental-sqlite dist/src/cli.js",
    "demo": "node --experimental-sqlite dist/src/demo.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
